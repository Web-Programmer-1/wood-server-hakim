{
  "name": "ph-health-care-starter",
  "version": "1.0.0",
  "main": "server.js",
  "author": "shafayat",
  "license": "MIT",
  "prisma": {
    "schema": "./prisma/schema"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "tsc",
    "start": "node --max-old-space-size=400 dist/server.js",
    "worker": "node --max-old-space-size=300 dist/workerOnly.js",
    "prod:pm2": "pm2 start ecosystem.config.js --env production",
    "prod:pm2:reload": "pm2 reload ecosystem.config.js --env production",
    "prod:pm2:logs": "pm2 logs wood-api",
    "prod:pm2:stop": "pm2 stop ecosystem.config.js",
    "prod:docker:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "prod:docker:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "prod:docker:logs": "docker compose -f docker-compose.yml -f docker-compose.prod.yml logs -f api",
    "prisma:deploy": "prisma migrate deploy",
    "deploy": "./deploy/deploy.sh",
    "healthcheck": "./deploy/healthcheck.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.954.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@prisma/client": "^6.16.3",
    "@types/nodemailer": "^7.0.2",
    "@types/qs": "^6.14.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.13.2",
    "bullmq": "^5.40.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "http-status": "^2.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "openai": "^6.3.0",
    "pdfkit": "^0.17.2",
    "qs": "^6.14.1",
    "redis": "^5.10.0",
    "slugify": "^1.6.6",
    "stripe": "^19.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^24.5.0",
    "@types/pdfkit": "^0.17.5",
    "prisma": "^6.16.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}