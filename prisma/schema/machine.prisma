model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  machines  Machine[]
}

model Machine {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  shortDesc      String?
  description    String?
  thumbnailImage String?
  bannerImage    String?
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  categoryId     String
  brand          String?
  model          String?
  features       Json?
  specifications Json?
  workSections   Json?
  dynamicButtons Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  stockQuantity  Int            @default(0)
  category       Category       @relation(fields: [categoryId], references: [id])
  images         MachineImage[]
  videos         MachineVideo[]

  // ===== Pricing (NEW) =====
  listPrice       Int // mandatory
  discountPercent Int? // 0–100
  discountPrice   Int? // auto-calculated
  bookedQty       Int  @default(0)

  // ---------------- 👤 Last Booking Info (simple) ----------------
  bookedName  String?
  bookedPhone String?
  bookedEmail String?
  bookedNote  String?

  @@index([categoryId])
  @@index([id])
  @@index([features])
  @@index([brand])
  @@index([model])
}

model MachineImage {
  id        String   @id @default(uuid())
  machineId String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model MachineVideo {
  id        String  @id @default(uuid())
  machineId String
  url       String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}
