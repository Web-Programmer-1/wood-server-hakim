model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  parentId    String?
  createdAt   DateTime   @default(now())
  description String?    @default("")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  machines    Machine[]
}

model Machine {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  shortDesc       String?
  description     String?
  thumbnailImage  String?
  bannerImage     String?
  isActive        Boolean        @default(true)
  isFeatured      Boolean        @default(false)
  categoryId      String
  brand           String?
  model           String?
  features        Json?
  specifications  Json?
  workSections    Json?
  dynamicButtons  Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  stockQuantity   Int            @default(0)
  bookedQty       Int            @default(0)
  discountPercent Int?
  discountPrice   Int?
  listPrice       Int
  bookedEmail     String?
  bookedName      String?
  bookedNote      String?
  bookedPhone     String?
  category        Category       @relation(fields: [categoryId], references: [id])
  images          MachineImage[]
  videos          MachineVideo[]

  @@index([categoryId])
  @@index([id])
  @@index([features])
  @@index([brand])
  @@index([model])
}

model MachineImage {
  id        String   @id @default(uuid())
  machineId String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model MachineVideo {
  id        String  @id @default(uuid())
  machineId String
  url       String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id        String   @id @default(uuid())
  itemType  String
  itemId    String
  type      String
  quantity  Int
  note      String?
  createdAt DateTime @default(now())

  @@index([itemType])
  @@index([itemId])
  @@index([createdAt])
}
