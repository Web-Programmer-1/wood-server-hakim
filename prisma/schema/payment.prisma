model Payment {
  id            String          @id @default(uuid())
  orderId       String
  provider      PaymentProvider
  status        MPaymentStatus  @default(INITIATED)
  amount        Int
  transactionId String?
  gatewayRef    String?
  sessionKey    String?
  redirectUrl   String?
  rawRequest    Json?
  rawResponse   Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([provider])
  @@index([status])
  @@index([transactionId])
}

enum PaymentProvider {
  SSLCOMMERZ
  BKASH
  COD
}

enum MPaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  REFUNDED
}
