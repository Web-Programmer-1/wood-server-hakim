model Inquiry {
  id        String   @id @default(uuid())
  code      String   @unique

  name      String
  email     String
  phone     String?

  subject   String
  message   String

  status    InquiryStatus @default(PENDING)


    respondedByAdminId String?
  respondedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum InquiryStatus {
  PENDING
  RESPONDED
  CONVERTED
}
