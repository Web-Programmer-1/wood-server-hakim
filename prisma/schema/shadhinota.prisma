model Shadhinota {
  id        String            @id @default(uuid())
  title     String
  subtitles Json?
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  images    ShadhinotaImage[]
  video     ShadhinotaVideo?

  @@index([sortOrder])
  @@index([createdAt])
  @@map("shadhinota_sections")
}

model ShadhinotaImage {
  id           String     @id @default(uuid())
  shadhinotaId String
  url          String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  shadhinota   Shadhinota @relation(fields: [shadhinotaId], references: [id], onDelete: Cascade)

  @@index([shadhinotaId])
  @@index([sortOrder])
  @@map("shadhinota_images")
}

model ShadhinotaVideo {
  id           String     @id @default(uuid())
  shadhinotaId String     @unique
  url          String
  createdAt    DateTime   @default(now())
  shadhinota   Shadhinota @relation(fields: [shadhinotaId], references: [id], onDelete: Cascade)

  @@map("shadhinota_videos")
}

model ShadhinotaUploadVideo {
  key       String   @id
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shadhinota_uploaded_videos")
}
