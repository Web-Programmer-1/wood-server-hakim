
model ServiceSection {
  id String @id @default(uuid())

  heading     String
  description String?

  primaryBtnText   String?
  primaryBtnUrl    String?
  secondaryBtnText String?
  secondaryBtnUrl  String?

  bgImageUrl String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([createdAt])
  @@map("service_sections")
}



model TestimonialSection {
  id String @id @default(uuid())

  avatarUrl String?
  description String?

  personName  String?
  companyName String?

  cardBgImageUrl String?

  videoType  String? 
  youtubeUrl String?
  videoUrl   String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([videoType])
  @@map("testimonial_sections")
}