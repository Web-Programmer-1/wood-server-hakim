model Footer {
  id String @id @default(uuid())

  logoUrl     String
  description String
  email       String
  phone       String

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Office {
  id String @id @default(uuid())

  title   String
  address String
  phone   String

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
