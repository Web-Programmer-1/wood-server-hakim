generator client {
  provider      = "prisma-client-js"
  // `native` covers local dev (mac/linux); `linux-musl-openssl-3.0.x` is
  // required for the alpine-based runtime image we ship in CI.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
