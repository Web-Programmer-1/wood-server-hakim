model Order {
  id            String        @id @default(uuid())
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  subTotal      Int
  shippingFee   Int           @default(0)
  discountTotal Int           @default(0)
  totalAmount   Int
  customerName  String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String?
  area          String?

  courierName     String? // Paperfly
  trackingNumber  String? // Z-051125-...
  trackingBarcode String?
  trackingToken   String? @unique

  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  payments  Payment[]

  couponId    String?
  couponCode  String?
  couponUsage CouponUsage?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  productSlug String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([id])
}

model ShippingRate {
  id        String   @id @default(uuid())
  city      String   @unique
  fee       Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([isActive])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  SSLCOMMARZE
  BKASH
  COD
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  UNPAID
  FAILED
  REFUNDED
}
