// =========================
// INVENTORY ENUMS
// =========================

enum StockMovementType {
  IN // Restock / Purchase
  OUT // Order shipped / manual out
  RESERVED // Order placed (hold)
  RELEASED // Order cancelled
  ADJUSTMENT // Manual correction
  DAMAGE // Damaged / lost
  RETURN // Customer return
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

// =========================
// PRODUCT INVENTORY
// (Single company storage)
// =========================

model ProductInventory {
  id String @id @default(uuid())

  productId String @unique
  sku       String @unique

  availableQty Int @default(0) // Sellable stock
  reservedQty  Int @default(0) // Order hold
  damagedQty   Int @default(0) // Damaged stock

  reorderLevel Int @default(5)

  costPrice   Int?
  averageCost Int?

  status InventoryStatus @default(IN_STOCK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visibility Boolean @default(true)

  // Relations
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([status])
}

// =========================
// STOCK MOVEMENT (AUDIT LOG)
// =========================

model StockMovement {
  id String @id @default(uuid())

  inventoryId String
  productId   String

  type     StockMovementType
  quantity Int

  previousQty Int
  currentQty  Int

  reason      String?
  referenceId String? // orderId / manual reference
  updatedBy   String? // admin userId (optional)

  createdAt DateTime @default(now())

  // Relations
  inventory ProductInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])

  @@index([inventoryId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}
