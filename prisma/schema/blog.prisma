model Blog {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String
  category    BlogCategory
  status      BlogStatus     @default(DRAFT)
  highlight   HighlightBadge @default(NONE)
  coverImage  String?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@index([status])
  @@map("blogs")
}

model Event {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String?
  category    EventCategory
  status      EventStatus    @default(UPCOMING)
  highlight   HighlightBadge @default(NONE)
  location    String
  startDate   DateTime
  endDate     DateTime
  bannerImage String?
  viewCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([category])
  @@index([startDate])
  @@map("events")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogCategory {
  CNC_GUIDE
  MACHINE_TIPS
  BUSINESS_INSIGHT
  INDUSTRY_NEWS
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventCategory {
  EXHIBITION
  TRAINING
  DEALER_MEET
  PRODUCT_LAUNCH
}

enum HighlightBadge {
  NONE
  NEW
  FEATURED
  LIVE
  ENDED
}
