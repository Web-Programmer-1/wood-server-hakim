# Environment
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL='postgresql://<username>:<password>@<host>/<database>?sslmode=require'

# JWT (Access & Refresh)
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_EXPIRE_IN="1h"

# Redis (OTP, optional cache, BullMQ queue — use REDIS_URL for hosted Redis)
REDIS_URL=redis://localhost:6379
REDIS_HOST='your_redis_host_url'
REDIS_PORT=6379
REDIS_PASS='your_redis_password'

# Multi-instance / ops (stateless + queue)
# ENABLE_DEBUG_CRON=true
# RUN_QUEUE_WORKER=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

NODE_ENV=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax



# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_test_secret_key

# JWT Tokens (Additional Settings)
JWT_SECRET=your_super_secret_jwt_key
EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d
RESET_PASS_TOKEN=your_reset_password_token_secret
RESET_PASS_TOKEN_EXPIRES_IN=1h

# Email Configuration
EMAIL="your_email@gmail.com"
APP_PASS="your_gmail_app_password"
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_email_password"
BUSINESS_EMAIL="your_business_email@gmail.com"

# Bcrypt Salt Rounds
SALT_ROUND=12

# Reset Password Link
RESET_PASS_LINK=http://localhost:3000/reset-password

# OTP (SMS)
SMS_SENDER=your_sms_sender_id
SMS_API_KEY=your_sms_api_key
SMS_CLIENT_ID=your_sms_client_id

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=your_aws_bucket_name

# System SMTP Inquiries
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your_smtp_user@gmail.com"
SMTP_PASS="your_smtp_password"
SYSTEM_SENDER_EMAIL="your_system_sender_email@gmail.com"

# ===============================
# SSLCOMMERZ CONFIG (SANDBOX/LIVE)
# ===============================
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_SESSION_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# CALLBACK URLs (BACKEND)
SSLCOMMERZ_SUCCESS_URL=http://localhost:5000/api/v1/payments/ssl/success
SSLCOMMERZ_FAIL_URL=http://localhost:5000/api/v1/payments/ssl/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5000/api/v1/payments/ssl/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/ssl/ipn

# FRONTEND REDIRECT (OPTIONAL)
SSLCOMMERZ_FRONTEND_SUCCESS=http://localhost:3000/payment/success
SSLCOMMERZ_FRONTEND_FAIL=http://localhost:3000/payment/failed
SSLCOMMERZ_FRONTEND_CANCEL=http://localhost:3000/payment/cancel

# -------------------- bKash Payment Credentials --------------------
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback

# COURIER PAPERFLY INTEGRATION
PAPERFLY_USERNAME=your_paperfly_username
PAPERFLY_PASSWORD=your_paperfly_password
PAPERFLY_KEY=your_paperfly_key