# =============================================================================
# Wood DB Backup — configuration template
#
# DO NOT put real credentials in this file (it's in git).
# Copy it to /etc/wood-backup.env on the VPS, fill in real values there,
# then lock it down: chmod 600 /etc/wood-backup.env
# =============================================================================

# --- Postgres (running inside Docker on the VPS) ---------------------------
PG_CONTAINER="wood-postgres"
PG_USER="wood_dev"
PG_DB="wood_database"

# --- Backblaze B2 (S3-compatible) ------------------------------------------
# Mirror these from your application .env.production on the VPS.
B2_ENDPOINT="https://s3.<region>.backblazeb2.com"
B2_REGION="<region>"               # e.g. eu-central-003
B2_ACCESS_KEY_ID="<keyID>"         # from B2 → App Keys
B2_SECRET_ACCESS_KEY="<applicationKey>"
B2_BUCKET="<bucket-name>"

# Object key prefix inside the bucket
B2_PREFIX="backups/wood_database"

# --- Local cache (kept on the VPS for fast restore) ------------------------
LOCAL_BACKUP_DIR="/var/backups/wood"
LOCAL_RETENTION_DAYS=7

# --- Optional: healthcheck ping (e.g. healthchecks.io / Better Uptime) -----
# Pinged AFTER a successful upload. Leave empty to disable.
HEALTHCHECK_URL=""

# --- Logging ---------------------------------------------------------------
LOG_FILE="/var/log/wood-backup.log"
