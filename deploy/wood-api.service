; systemd unit for the API server.
;
; Install:
;   sudo cp deploy/wood-api.service /etc/systemd/system/wood-api.service
;   # edit User, WorkingDirectory, and EnvironmentFile to match your VPS
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now wood-api
;
; Operate:
;   sudo systemctl status wood-api
;   sudo systemctl restart wood-api
;   journalctl -u wood-api -f          # live logs
;   journalctl -u wood-api --since "1 hour ago"
;
; The unit restarts the process on ANY exit (crash, OOM, code 1) with a
; 5s backoff. StartLimit prevents tight crash loops.
[Unit]
Description=Wood API (Node.js)
Documentation=https://github.com/your-org/wood-server-hakim
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple

; --- Edit these for your VPS ---
User=ubuntu
Group=ubuntu
WorkingDirectory=/root/wood-server-hakim
EnvironmentFile=/root/wood-server-hakim/.env.production
; -------------------------------

Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=400

ExecStart=/usr/bin/node dist/server.js

; Graceful shutdown: send SIGTERM, then SIGKILL after 25s.
KillSignal=SIGTERM
TimeoutStopSec=25
KillMode=mixed

; Auto-restart policy
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10

; Output to journald — read with `journalctl -u wood-api`
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wood-api

; Resource limits (tune for your VPS)
LimitNOFILE=65535

; Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target